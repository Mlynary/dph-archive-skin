{
  "$schema": "https://design-tokens.org/schema.json",
  "meta": {
    "name": "DPH Archive OS",
    "version": "1.0.0",
    "source": "runs/BV1rr4y1b7sz (style study only, no source assets used)",
    "brandSource": "~/.dsh/dsh-startup.json (DPH accent #FF7500)",
    "styleFamily": "technical dossier / OS specimen sheet",
    "signature": [
      "warm paper ground with a hairline grid",
      "zero radius: every container is razor-sharp except status dots",
      "3-4 letter uppercase code chips in black blocks",
      "9px micro-labels with wide tracking, bilingual zh/en pairing",
      "one hairline system instead of shadows on the light surface",
      "a single warm accent used at under 2% of surface area"
    ]
  },

  "color": {
    "primitive": {
      "ink-950": "#0B0F0D",
      "ink-900": "#101512",
      "ink-700": "#3A403C",
      "ink-500": "#5B605B",
      "paper-50": "#F6F4F0",
      "paper-100": "#F1EEE9",
      "paper-200": "#E7E4DF",
      "paper-300": "#D6D1C9",
      "paper-400": "#BEB8AE",
      "grey-450": "#8C8880",
      "blue-600": "#1F5C99",
      "blue-500": "#2971B8",
      "blue-300": "#6FA3D6",
      "amber-600": "#A34700",
      "amber-500": "#FF7500",
      "red-600": "#B62A1E",
      "red-500": "#FF3B30",
      "green-600": "#3F6B3B",
      "night-000": "#0A0A0B",
      "night-100": "#141414",
      "night-200": "#1D1B19"
    },
    "semantic": {
      "light": {
        "bg-paper": "{color.primitive.paper-200}",
        "bg-raised": "{color.primitive.paper-50}",
        "bg-sunken": "{color.primitive.paper-300}",
        "bg-invert": "{color.primitive.ink-950}",
        "fg-primary": "{color.primitive.ink-950}",
        "fg-secondary": "{color.primitive.ink-700}",
        "fg-muted": "{color.primitive.ink-500}",
        "fg-invert": "{color.primitive.paper-50}",
        "rule": "rgba(11,15,13,0.16)",
        "rule-strong": "rgba(11,15,13,0.32)",
        "grid": "rgba(11,15,13,0.05)",
        "accent": "{color.primitive.amber-500}",
        "accent-text": "{color.primitive.amber-600}",
        "accent-invert": "{color.primitive.amber-500}",
        "system": "{color.primitive.blue-500}",
        "system-text": "{color.primitive.blue-600}",
        "alert": "{color.primitive.red-600}",
        "alert-flash": "{color.primitive.red-500}",
        "ok": "{color.primitive.green-600}"
      },
      "dark": {
        "bg-paper": "{color.primitive.night-000}",
        "bg-raised": "{color.primitive.night-100}",
        "bg-sunken": "{color.primitive.night-200}",
        "bg-invert": "{color.primitive.paper-100}",
        "fg-primary": "#E9E5DF",
        "fg-secondary": "rgba(233,229,223,0.74)",
        "fg-muted": "rgba(233,229,223,0.52)",
        "fg-invert": "{color.primitive.night-000}",
        "rule": "rgba(233,229,223,0.16)",
        "rule-strong": "rgba(233,229,223,0.34)",
        "grid": "rgba(233,229,223,0.045)",
        "accent": "#FF8A34",
        "accent-text": "#FFA766",
        "accent-invert": "#B24A00",
        "system": "{color.primitive.blue-300}",
        "system-text": "#8FBCE8",
        "alert": "#F2654F",
        "alert-flash": "{color.primitive.red-500}",
        "ok": "#7DA877"
      }
    }
  },

  "typography": {
    "family": {
      "sans": "\"Inter\", \"Helvetica Neue\", \"Segoe UI\", \"Noto Sans SC\", \"Microsoft YaHei\", system-ui, sans-serif",
      "mono": "\"JetBrains Mono\", \"Cascadia Mono\", Consolas, \"SF Mono\", ui-monospace, monospace"
    },
    "weight": { "regular": 400, "medium": 500, "bold": 700, "heavy": 800 },
    "size": {
      "micro": "9px",
      "xs": "10.5px",
      "sm": "12px",
      "md": "14px",
      "lg": "18px",
      "xl": "27px",
      "2xl": "44px",
      "ghost": "96px"
    },
    "leading": { "tight": 1.05, "snug": 1.25, "normal": 1.5, "loose": 1.7 },
    "tracking": {
      "micro": "0.14em",
      "label": "0.08em",
      "code": "-0.02em",
      "display": "-0.035em"
    }
  },

  "space": {
    "0": "0px",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px"
  },

  "radius": {
    "none": "0px",
    "chip": "2px",
    "dot": "999px"
  },

  "border": {
    "hairline": "1px",
    "rule": "1px",
    "heavy": "2px"
  },

  "elevation": {
    "light": {
      "sheet": "0 18px 40px rgba(11,15,13,0.10)",
      "chip": "0 2px 6px rgba(11,15,13,0.08)",
      "none": "none"
    },
    "dark": {
      "sheet": "0 18px 40px rgba(0,0,0,0.55)",
      "chip": "none",
      "none": "none"
    }
  },

  "motion": {
    "duration": { "fast": "120ms", "base": "160ms", "slow": "320ms" },
    "ease": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "exit": "cubic-bezier(0.4, 0, 1, 1)"
    }
  },

  "icon": {
    "size": { "xs": "12", "sm": "16", "md": "20", "lg": "22" },
    "stroke": "1.5",
    "cap": "butt",
    "join": "miter"
  },

  "layout": {
    "topbar": "56px",
    "bottombar": "30px",
    "railLeft": "216px",
    "railRight": "300px",
    "contentMax": "760px",
    "gridSize": "32px",
    "cropInset": "10px",
    "cropArm": "14px"
  },

  "app": {
    "note": "Harness alias-layer override (ctx.theme.overrideTokens). Only the 14 colours the Client theme service exposes are touched.",
    "light": {
      "--dsw-alias-bg-base": "#E7E4DF",
      "--dsw-alias-bg-layer-1": "#F2EFEA",
      "--dsw-alias-bg-layer-2": "#DDD9D2",
      "--dsw-alias-bg-overlay": "#F7F5F1",
      "--dsw-alias-border-l1": "#0B0F0D29",
      "--dsw-alias-border-l2": "#0B0F0D4D",
      "--dsw-alias-brand-primary": "#A34700",
      "--dsw-alias-label-primary": "#0B0F0D",
      "--dsw-alias-label-secondary": "#4C514C",
      "--dsw-alias-state-error-primary": "#B62A1E",
      "--dsw-alias-state-idle-primary": "#6E736E",
      "--dsw-alias-state-success-primary": "#2F6B2A",
      "--dsw-alias-state-warn-primary": "#8A4A00",
      "--dsw-specific-sidebar-fill": "#D8D3CB"
    },
    "dark": {
      "--dsw-alias-bg-base": "#0A0A0B",
      "--dsw-alias-bg-layer-1": "#151513",
      "--dsw-alias-bg-layer-2": "#1E1C19",
      "--dsw-alias-bg-overlay": "#211F1C",
      "--dsw-alias-border-l1": "#E9E5DF29",
      "--dsw-alias-border-l2": "#E9E5DF4D",
      "--dsw-alias-brand-primary": "#FF9A4D",
      "--dsw-alias-label-primary": "#E9E5DF",
      "--dsw-alias-label-secondary": "#A8A49D",
      "--dsw-alias-state-error-primary": "#F2654F",
      "--dsw-alias-state-idle-primary": "#7C817C",
      "--dsw-alias-state-success-primary": "#7DA877",
      "--dsw-alias-state-warn-primary": "#E0A04A",
      "--dsw-specific-sidebar-fill": "#111110"
    }
  }
}
